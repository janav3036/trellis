# ── Core ────────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=            # random hex string, e.g. `openssl rand -hex 32`
TRELLIS_PASSWORD=            # your login password
DATA_DIR=/data               # Railway persistent volume mount point

# ── Spotify ──────────────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=       # obtain locally then copy here; app auto-refreshes access token
SPOTIFY_REDIRECT_URI=        # https://<your-railway-domain>/api/callback/spotify

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_USERNAME=

# ── Weather / Sky ─────────────────────────────────────────────────────────────
WEATHER_LAT=
WEATHER_LON=

# ── APIs ──────────────────────────────────────────────────────────────────────
TMDB_API_KEY=
NASA_API_KEY=                # optional, defaults to DEMO_KEY (rate-limited)

# ── Google Calendar ───────────────────────────────────────────────────────────
GOOGLE_CALENDAR_TOKEN_JSON=  # full JSON string from keyring.get_password("trellis-calendar","token_json")

# ── Cloudinary (F1 photos / journal photos) ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Letters cron ─────────────────────────────────────────────────────────────
CRON_SECRET=                 # shared secret for /api/cron/check-letters Authorization header
GMAIL_USER=                  # defaults to janavdshah30@gmail.com if not set
GMAIL_APP_PASSWORD=          # Gmail app password (not your account password)

# ── Litestream S3 backup (optional) ──────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
